# Токен Telegram-бота от @BotFather
BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN

# Telegram user_id администратора (получить через @userinfobot)
ADMIN_ID=REPLACE_WITH_YOUR_ADMIN_ID

# Публичный HTTPS-URL, на котором доступно мини-приложение (для WebApp кнопки)
WEBAPP_URL=https://example.com

# Строка подключения к БД (для MVP — локальный SQLite)
DATABASE_URL=sqlite:///./db/blacklotus.db

# Порт FastAPI-бэкенда
WEBAPP_PORT=8080
