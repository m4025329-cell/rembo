# =====================================================================
#  BlackLotusVPN — пример .env. Скопируй как .env и заполни значения.
#  РЕАЛЬНЫЙ .env НИКОГДА НЕ КОММИТИТСЯ (см. .gitignore).
# =====================================================================

# ── Telegram ────────────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN
# Главный админ (@userinfobot). Дополнительных перечисли через запятую в ADMIN_IDS.
ADMIN_ID=REPLACE_WITH_YOUR_ADMIN_ID
ADMIN_IDS=
# Юзернейм оператора поддержки (без @) — используется в кнопке «Написать»
SUPPORT_USERNAME=@pivozavr35
# Название сервиса
SERVICE_NAME=BlackLotusVPN

# ── Мини-приложение ────────────────────────────────────────────────
# HTTPS-URL, где хостится /webapp/index.html (GitHub Pages / свой домен)
WEBAPP_URL=https://example.com
WEBAPP_PORT=8080
ALLOWED_ORIGIN=
# В prod = false; true даёт dev-fallback без initData (для отладки).
DEBUG=false

# ── База данных ────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./vpn_bot.db
DB_PASSWORD=

# ── Шифрование секретов в БД (Fernet) ──────────────────────────────
# Сгенерируй: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ── RollyPay (платежи) ──────────────────────────────────────────────
# API-ключ и секрет подписи — выдаются при создании кассы на rollypay.io
ROLLYPAY_API_KEY=
ROLLYPAY_SIGNING_SECRET=
ROLLYPAY_API_URL=https://api.rollypay.io

# ── VPN-сервер (панель 3x-ui) ─────────────────────────────────────────
# Без этого блока бот выдаёт DEMO-ключи (нерабочие, для разработки/демо).
# Как заполнить — см. vpn-server/README.md, шаг «Подключить панель к боту».
XUI_PANEL_URL=
XUI_USERNAME=
XUI_PASSWORD=
XUI_INBOUND_ID=
XUI_SERVER_HOST=
XUI_SERVER_PORT=443
XUI_REALITY_PUBLIC_KEY=
XUI_REALITY_SHORT_ID=
XUI_REALITY_SNI=www.microsoft.com
XUI_FLOW=xtls-rprx-vision

# ── Email (подтверждение регистрации в личном кабинете по почте) ────
# Без этого блока код верификации пишется в лог вместо письма (dev).
# Подойдёт любой SMTP: Yandex (smtp.yandex.ru:587), Gmail app-password,
# почтовый сервис хостинга и т.п.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── SMS (подтверждение регистрации по телефону, sms.ru) ──────────────
# Без этого блока код верификации пишется в лог вместо SMS (dev).
# API ID — в личном кабинете sms.ru → «Мой профиль» → «API-ключи».
SMS_RU_API_ID=

# ── Аутентификация / API ────────────────────────────────────────────
JWT_SECRET=
PAYMENT_SECRET=

# ── Бэкапы ──────────────────────────────────────────────────────────
BACKUP_GPG_RECIPIENT=
BACKUP_REMOTE=

# ── Тарификация ─────────────────────────────────────────────────────
BASE_PRICE=150
DEVICE_PRICE=75

# ── Rate limit ──────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
BOT_FLOOD_LIMIT_PER_SECOND=5
