# =====================================================================
#  BlackLotusVPN — пример .env. Скопируй как .env и заполни значения.
#  РЕАЛЬНЫЙ .env НИКОГДА НЕ КОММИТИТСЯ (см. .gitignore).
# =====================================================================

# ── Telegram ────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=
# Telegram user_id администратора (получить у @userinfobot)
ADMIN_ID=

# ── Мини-приложение ────────────────────────────────────────────────
# Публичный HTTPS-URL для WebApp (обязателен для боевого режима)
WEBAPP_URL=
# Порт FastAPI (внутренний)
WEBAPP_PORT=8080
# Разрешённый Origin для CORS (обычно == WEBAPP_URL)
ALLOWED_ORIGIN=
# Включает dev-fallback (initData не требуется). НЕ ВКЛЮЧАТЬ В ПРОДЕ.
DEBUG=false

# ── База данных ────────────────────────────────────────────────────
# Для SQLite: путь к файлу (файл вне репозитория, права 600)
DATABASE_URL=sqlite:///./db-data/blacklotus.db
# Пароль СУБД (если используется PostgreSQL/MySQL). Для SQLite можно пусто.
DB_PASSWORD=

# ── Шифрование секретов в БД (Fernet) ──────────────────────────────
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ── Аутентификация / API ────────────────────────────────────────────
# Секрет для подписи внутренних JWT (32+ случайных символа)
JWT_SECRET=
# Ключ API 3x-ui / Marzban / другой панели
XRAY_API_KEY=
# Секрет для валидации callback'ов платёжки (ЮKassa / Crypto / Stars)
PAYMENT_SECRET=

# ── Бэкапы ──────────────────────────────────────────────────────────
# GPG-получатель для шифрования бэкапов (email/keyid)
BACKUP_GPG_RECIPIENT=
# Куда лить бэкапы (rsync/scp): user@host:/path
BACKUP_REMOTE=

# ── Rate limit ──────────────────────────────────────────────────────
# Максимум запросов на IP в минуту
RATE_LIMIT_PER_MINUTE=30
# Максимум сообщений от одного пользователя бота в секунду
BOT_FLOOD_LIMIT_PER_SECOND=5
